<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="bootloader_RV32I"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
bootloader_RV32I
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="bootloader_RV32I">
        <sdx:configuration sdx:name="bootloader_RV32I"
                           sdx:displayName="bootloader_RV32I"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>bootloader_RV32I</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="bootloader_RV32I/boot/bootloader_RV32I.bif"
                            sdx:readme="bootloader_RV32I/boot/generic.readme"
                            sdx:qemuArguments="bootloader_RV32I/qemu/pmu_args.txt:bootloader_RV32I/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="bootloader_RV32I/boot/bootloader_RV32I.bif"
                            sdx:readme="bootloader_RV32I/boot/generic.readme"
                            sdx:qemuArguments="bootloader_RV32I/standalone_domain/qemu/pmu_args.txt:bootloader_RV32I/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on psu_cortexa53_0"
                                sdx:cpuType="cortex-a53"
                                sdx:cpuInstance="psu_cortexa53_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="bootloader_RV32I/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="bootloader_RV32I/standalone_domain/bspinclude/include"
                        sdx:bspConfig="bootloader_RV32I/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
