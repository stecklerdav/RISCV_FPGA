
TC-010 — Branch
Escenario: BEQ/BNE tomado y no tomado
.section .text.start
.globl _start

_start:
    addi x1, x0, 5
    addi x2, x0, 5
    beq  x1, x2, beq_ok
    addi x3, x0, 11          # wrong-path

beq_ok:
    addi x4, x0, 1
    bne  x1, x2, bne_fail
    addi x5, x0, 2           # sí debe ejecutar
    jal  x0, done

bne_fail:
    addi x6, x0, 99

done:
    jal x0, done

Esperado:

beq tomado
bne no tomado
x3 no se escribe
x5 = 2
