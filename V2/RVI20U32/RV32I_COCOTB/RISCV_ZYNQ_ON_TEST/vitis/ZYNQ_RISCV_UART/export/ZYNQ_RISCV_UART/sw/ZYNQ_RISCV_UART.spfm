<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="ZYNQ_RISCV_UART"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
ZYNQ_RISCV_UART
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="ZYNQ_RISCV_UART">
        <sdx:configuration sdx:name="ZYNQ_RISCV_UART"
                           sdx:displayName="ZYNQ_RISCV_UART"
                           sdx:defaultProcessorGroup="domain_psu_cortexa53_0"
                           sdx:runtimes="cpp">
            <sdx:description>ZYNQ_RISCV_UART</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="ZYNQ_RISCV_UART/boot/ZYNQ_RISCV_UART.bif"
                            sdx:readme="ZYNQ_RISCV_UART/boot/generic.readme"
                            sdx:qemuArguments="ZYNQ_RISCV_UART/qemu/pmu_args.txt:ZYNQ_RISCV_UART/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="ZYNQ_RISCV_UART/boot/ZYNQ_RISCV_UART.bif"
                            sdx:readme="ZYNQ_RISCV_UART/boot/generic.readme"
                            sdx:qemuArguments="ZYNQ_RISCV_UART/standalone_domain/qemu/pmu_args.txt:ZYNQ_RISCV_UART/standalone_domain/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="domain_psu_cortexa53_0"
                            sdx:bif="ZYNQ_RISCV_UART/boot/ZYNQ_RISCV_UART.bif"
                            sdx:readme="ZYNQ_RISCV_UART/boot/generic.readme"
                            sdx:qemuArguments="ZYNQ_RISCV_UART/domain_psu_cortexa53_0/qemu/pmu_args.txt:ZYNQ_RISCV_UART/domain_psu_cortexa53_0/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on psu_cortexa53_0"
                                sdx:cpuType="cortex-a53"
                                sdx:cpuInstance="psu_cortexa53_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="ZYNQ_RISCV_UART/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="ZYNQ_RISCV_UART/standalone_domain/bspinclude/include"
                        sdx:bspConfig="ZYNQ_RISCV_UART/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
            <sdx:processorGroup sdx:name="domain_psu_cortexa53_0"
                                sdx:displayName="domain_psu_cortexa53_0"
                                sdx:cpuType="cortex-a53"
                                sdx:cpuInstance="psu_cortexa53_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="ZYNQ_RISCV_UART/domain_psu_cortexa53_0/bsplib/lib"
                        sdx:bspIncludePaths="ZYNQ_RISCV_UART/domain_psu_cortexa53_0/bspinclude/include"
                        sdx:bspConfig="ZYNQ_RISCV_UART/domain_psu_cortexa53_0/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
