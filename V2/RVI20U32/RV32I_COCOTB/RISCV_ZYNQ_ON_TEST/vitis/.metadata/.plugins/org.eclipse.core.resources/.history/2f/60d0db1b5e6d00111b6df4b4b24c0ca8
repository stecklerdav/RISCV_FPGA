#include "xuartps.h"
#include "xparameters.h"
#include "xil_printf.h"
#include "xstatus.h"
#include "sleep.h"

static XUartPs uart_pc;
static XUartPs uart_riscv;

static int init_uart(XUartPs *uart, u16 dev_id)
{
    XUartPs_Config *cfg;
    int status;

    cfg = XUartPs_LookupConfig(dev_id);
    if (cfg == NULL)
        return XST_FAILURE;

    status = XUartPs_CfgInitialize(uart, cfg, cfg->BaseAddress);
    if (status != XST_SUCCESS)
        return XST_FAILURE;

    status = XUartPs_SetBaudRate(uart, 115200);
    if (status != XST_SUCCESS)
        return XST_FAILURE;

    return XST_SUCCESS;
}

int main(void)
{
    u8 c;

    if (init_uart(&uart_pc, XPAR_XUARTPS_0_DEVICE_ID) != XST_SUCCESS)
        return XST_FAILURE;

    if (init_uart(&uart_riscv, XPAR_XUARTPS_1_DEVICE_ID) != XST_SUCCESS) {
        xil_printf("\r\nERROR: UART1 init failed\r\n");
        return XST_FAILURE;
    }

    xil_printf("\r\nA53 UART BRIDGE READY\r\n");
    xil_printf("UART1 EMIO RISC-V -> UART0 PC\r\n\r\n");

  // XUartPs_ResetHw(uart_riscv.Config.BaseAddress);
   // XUartPs_SetBaudRate(&uart_riscv, 115200);

    while (1) {
        while (XUartPs_IsReceiveData(uart_riscv.Config.BaseAddress)) {
            c = XUartPs_ReadReg(uart_riscv.Config.BaseAddress, XUARTPS_FIFO_OFFSET);

            XUartPs_SendByte(uart_pc.Config.BaseAddress, c);
        }

        u32 sr = XUartPs_ReadReg(uart_riscv.Config.BaseAddress, XUARTPS_SR_OFFSET);
        xil_printf("UART1 SR = 0x%08lx\r\n", sr);

        //sleep(1);
    }

    return XST_SUCCESS;
}
