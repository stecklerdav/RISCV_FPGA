#include "xuartps.h"
#include "xparameters.h"
#include "xstatus.h"
#include "xil_printf.h"

static XUartPs uart_pc;
static XUartPs uart_riscv;

static int init_uart(XUartPs *uart, u16 dev_id)
{
    XUartPs_Config *cfg;
    int status;

    cfg = XUartPs_LookupConfig(dev_id);
    if (cfg == NULL)
        return XST_FAILURE;

    status = XUartPs_CfgInitialize(uart, cfg, cfg->BaseAddress);
    if (status != XST_SUCCESS)
        return XST_FAILURE;

    status = XUartPs_SetBaudRate(uart, 115200);
    if (status != XST_SUCCESS)
        return XST_FAILURE;

    return XST_SUCCESS;
}

static void pc_putc(u8 c)
{
    XUartPs_SendByte(uart_pc.Config.BaseAddress, c);
}

static void pc_puts(const char *s)
{
    while (*s)
        pc_putc((u8)*s++);
}

static void riscv_putc(u8 c)
{
    XUartPs_SendByte(uart_riscv.Config.BaseAddress, c);
}

int main(void)
{
    u8 c;

    if (init_uart(&uart_pc, XPAR_XUARTPS_0_DEVICE_ID) != XST_SUCCESS)
        return XST_FAILURE;

    if (init_uart(&uart_riscv, XPAR_XUARTPS_1_DEVICE_ID) != XST_SUCCESS) {
        xil_printf("\r\nERROR UART1 init\r\n");
        return XST_FAILURE;
    }

    xil_printf("\r\nA53 UART DEBUG BRIDGE OK\r\n");
    xil_printf("Lo que escribes NO se imprime localmente.\r\n");
    xil_printf("Solo veras respuesta marcada desde RISC-V.\r\n\r\n");

    while (1)
    {
        if (XUartPs_IsReceiveData(uart_pc.Config.BaseAddress)) {
            c = XUartPs_ReadReg(uart_pc.Config.BaseAddress, XUARTPS_FIFO_OFFSET);
            XUartPs_SendByte(uart_riscv.Config.BaseAddress, c);
        }

        if (XUartPs_IsReceiveData(uart_riscv.Config.BaseAddress)) {
            c = XUartPs_ReadReg(uart_riscv.Config.BaseAddress, XUARTPS_FIFO_OFFSET);
            XUartPs_SendByte(uart_pc.Config.BaseAddress, c);
        }
    }

    return XST_SUCCESS;
}
