#include "xuartps.h"
#include "xparameters.h"
#include "xstatus.h"
#include "xil_printf.h"

#define BUF_SIZE 128

static XUartPs uart_pc;
static XUartPs uart_riscv;

static int init_uart(XUartPs *uart, u16 dev_id)
{
    XUartPs_Config *cfg = XUartPs_LookupConfig(dev_id);
    if (cfg == NULL) return XST_FAILURE;

    int status = XUartPs_CfgInitialize(uart, cfg, cfg->BaseAddress);
    if (status != XST_SUCCESS) return XST_FAILURE;

    return XUartPs_SetBaudRate(uart, 115200);
}

static void send_byte(XUartPs *uart, u8 c)
{
    XUartPs_SendByte(uart->Config.BaseAddress, c);
}

int main(void)
{
    char line[BUF_SIZE];
    unsigned int idx = 0;
    u8 c;

    init_uart(&uart_pc,    XPAR_XUARTPS_0_DEVICE_ID);
    init_uart(&uart_riscv, XPAR_XUARTPS_1_DEVICE_ID);

    xil_printf("\r\nA53 LINE BRIDGE READY\r\n> ");

    while (1) {
        if (XUartPs_IsReceiveData(uart_pc.Config.BaseAddress)) {
            c = XUartPs_ReadReg(uart_pc.Config.BaseAddress, XUARTPS_FIFO_OFFSET);

            if (c == '\r' || c == '\n') {
                send_byte(&uart_riscv, '\n');
                idx = 0;
                xil_printf("\r\n> ");
            } else {
                if (idx < BUF_SIZE - 1) {
                    line[idx++] = (char)c;
                    send_byte(&uart_riscv, c);
                    send_byte(&uart_pc, c);   // eco local
                }
            }
        }

        if (XUartPs_IsReceiveData(uart_riscv.Config.BaseAddress)) {
            c = XUartPs_ReadReg(uart_riscv.Config.BaseAddress, XUARTPS_FIFO_OFFSET);
            send_byte(&uart_pc, c);
        }
    }
}
