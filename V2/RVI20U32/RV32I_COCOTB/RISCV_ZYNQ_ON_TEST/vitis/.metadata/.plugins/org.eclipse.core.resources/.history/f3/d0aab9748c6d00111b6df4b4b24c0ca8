#include "xuartps.h"
#include "xparameters.h"
#include "xstatus.h"
#include "xil_printf.h"

static XUartPs uart_pc;
static XUartPs uart_riscv;

static int init_uart(XUartPs *uart, u16 dev_id)
{
    XUartPs_Config *cfg;
    int status;

    cfg = XUartPs_LookupConfig(dev_id);
    if (cfg == NULL)
        return XST_FAILURE;

    status = XUartPs_CfgInitialize(uart, cfg, cfg->BaseAddress);
    if (status != XST_SUCCESS)
        return XST_FAILURE;

    status = XUartPs_SetBaudRate(uart, 115200);
    if (status != XST_SUCCESS)
        return XST_FAILURE;

    return XST_SUCCESS;
}

static void send_byte(XUartPs *uart, u8 c)
{
    XUartPs_SendByte(uart->Config.BaseAddress, c);
}

static int recv_byte_timeout(XUartPs *uart, u8 *c, unsigned int timeout)
{
    while (timeout--) {
        if (XUartPs_IsReceiveData(uart->Config.BaseAddress)) {
            *c = XUartPs_ReadReg(uart->Config.BaseAddress,
                                  XUARTPS_FIFO_OFFSET);
            return XST_SUCCESS;
        }
    }

    return XST_FAILURE;
}


