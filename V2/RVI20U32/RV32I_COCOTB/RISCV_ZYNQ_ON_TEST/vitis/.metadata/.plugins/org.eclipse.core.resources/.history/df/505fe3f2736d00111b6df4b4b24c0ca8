#include "xuartps.h"
#include "xparameters.h"
#include "xil_printf.h"
#include "xstatus.h"
#include "sleep.h"

static XUartPs uart_pc;
static XUartPs uart_riscv;

static int init_uart(XUartPs *uart, u16 dev_id)
{
    XUartPs_Config *cfg;
    int status;

    cfg = XUartPs_LookupConfig(dev_id);
    if (cfg == NULL)
        return XST_FAILURE;

    status = XUartPs_CfgInitialize(uart, cfg, cfg->BaseAddress);
    if (status != XST_SUCCESS)
        return XST_FAILURE;

    status = XUartPs_SetBaudRate(uart, 115200);
    if (status != XST_SUCCESS)
        return XST_FAILURE;

    return XST_SUCCESS;
}

static void uart_send_byte(XUartPs *uart, u8 c)
{
    XUartPs_SendByte(uart->Config.BaseAddress, c);
}

static int uart_recv_byte_timeout(XUartPs *uart, u8 *c, unsigned int timeout)
{
    while (timeout > 0) {
        if (XUartPs_IsReceiveData(uart->Config.BaseAddress)) {
            *c = XUartPs_ReadReg(
                uart->Config.BaseAddress,
                XUARTPS_FIFO_OFFSET
            );
            return XST_SUCCESS;
        }

        timeout--;
    }

    return XST_FAILURE;
}

int main(void)
{
    u8 tx = 0x55;
    u8 rx = 0;

    if (init_uart(&uart_pc, XPAR_XUARTPS_0_DEVICE_ID) != XST_SUCCESS)
        return XST_FAILURE;

    if (init_uart(&uart_riscv, XPAR_XUARTPS_1_DEVICE_ID) != XST_SUCCESS) {
        xil_printf("\r\nERROR: UART1 init failed\r\n");
        return XST_FAILURE;
    }

    xil_printf("\r\nA53 UART EXCHANGE TEST\r\n");
    xil_printf("Sending 0x55 to RISC-V, waiting echo...\r\n\r\n");

    while (1) {
        uart_send_byte(&uart_riscv, tx);

        if (uart_recv_byte_timeout(&uart_riscv, &rx, 1000000) == XST_SUCCESS) {
            xil_printf("TX=0x%02X  RX=0x%02X  %s\r\n",
                       tx,
                       rx,
                       (rx == tx) ? "OK" : "FAIL");
        } else {
            xil_printf("TIMEOUT waiting RISC-V echo\r\n");
        }

        sleep(1);
    }

    return XST_SUCCESS;
}
