:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5f05a63a1530 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x5f05a63a16c0 .scope module, "alu" "alu" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 32 "a";
    .port_info 1 /INPUT 32 "b";
    .port_info 2 /OUTPUT 32 "y";
o0x772982ee3018 .functor BUFZ 32, C4<zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz>; HiZ drive
v0x5f05a63b34a0_0 .net "a", 31 0, o0x772982ee3018;  0 drivers
o0x772982ee3048 .functor BUFZ 32, C4<zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz>; HiZ drive
v0x5f05a63e8890_0 .net "b", 31 0, o0x772982ee3048;  0 drivers
v0x5f05a63e8970_0 .net "y", 31 0, L_0x5f05a63e8ab0;  1 drivers
L_0x5f05a63e8ab0 .arith/sum 32, o0x772982ee3018, o0x772982ee3048;
