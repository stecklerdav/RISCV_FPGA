#include "xil_cache.h"
#include <stdint.h>

#define BRAM_BASE 0xA0000000U
#define RV_RESET_ADDR 0xA0001000U  // si usas GPIO para reset

extern unsigned char prog_bin[];
extern unsigned int  prog_bin_len;

int main()
{
    volatile uint32_t *bram = (uint32_t*)BRAM_BASE;

    // 1️⃣ Mantener reset activo (si usas GPIO)
    // *(volatile uint32_t*)RV_RESET_ADDR = 1;

    // 2️⃣ Copiar programa
    for (unsigned i = 0; i < prog_bin_len/4; i++)
        bram[i] = ((uint32_t*)prog_bin)[i];

    // 3️⃣ Flush cache (UltraScale+ importante)
    Xil_DCacheFlush();

    // 4️⃣ Liberar reset
    // *(volatile uint32_t*)RV_RESET_ADDR = 0;

    while(1);
}
