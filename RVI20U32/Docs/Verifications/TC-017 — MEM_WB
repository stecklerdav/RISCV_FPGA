
TC-017 — MEM/WB
Escenario: selección wb de ALU / MEM / PC+4 / IMM
.section .text.start
.globl _start

.equ RAM_BASE, 0x00000100

_start:
    addi x1, x0, 7           # fuente ALU
    lui  x2, 0x12345         # fuente IMM/U
    lui  x10, %hi(RAM_BASE)
    addi x10, x10, %lo(RAM_BASE)

    sw   x1, 0(x10)
    lw   x3, 0(x10)          # fuente MEM

    jal  x4, target          # fuente PC+4
    addi x5, x0, 99          # wrong-path

target:
    addi x6, x0, 1

done:
    jal x0, done

Esperado:

x1 por ALU
x2 por IMM/LUI
x3 por MEM
x4 por PC+4
x5 no se escribe
