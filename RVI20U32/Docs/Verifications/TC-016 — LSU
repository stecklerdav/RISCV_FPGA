
TC-016 — LSU
Escenario: SB/SH/SW con byte enables
.section .text.start
.globl _start

.equ RAM_BASE, 0x00000100

_start:
    lui  x10, %hi(RAM_BASE)
    addi x10, x10, %lo(RAM_BASE)

    addi x1, x0, 0x11
    sb   x1, 0(x10)

    lui  x2, 0x00002         # 0x00002000
    addi x2, x2, 0x22
    sh   x2, 4(x10)

    lui  x3, 0x12345
    addi x3, x3, 0x678
    sw   x3, 8(x10)

    lb   x4, 0(x10)
    lh   x5, 4(x10)
    lw   x6, 8(x10)

done:
    jal x0, done

Esperado:

byte enables correctos en store
x4, x5, x6 recuperan los datos escritos
